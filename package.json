{
  "name": "brewlucks-coffeeshop",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "npm run db:sync",
    "dev": "next dev",
    "prebuild": "npm run db:sync",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "db:sync": "tsx scripts/fetch-catalog.ts",
    "db:seed": "tsx scripts/seed-supabase.ts",
    "db:setup-auth": "tsx scripts/setup-auth-schema.ts",
    "db:setup-profile": "tsx scripts/setup-profile-storage.ts"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@opennextjs/cloudflare": "^1.20.6",
    "@supabase/supabase-js": "^2.116.0",
    "gsap": "^3.15.0",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "postgres": "^3.4.9",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "wrangler": "^4.130.0"
  }
}
